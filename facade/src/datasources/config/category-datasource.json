{
  "name": "category",
  "connector": "rest",
  "baseURL": "http://localhost:3003",
  "crud": false,
  "operations": [
    {
      "template": {
        "method": "GET",
        "url": "http://localhost:3003/categories",
        "query": {
          "name": "{name}"
        },
        "headers": {
          "accept": "application/json"
        }
      },
      "functions": {
        "findCategoryByName": ["name"]
      }
    },
    {
      "template": {
        "method": "POST",
        "url": "http://localhost:3003/categories",
        "headers": {
          "accept": "application/json",
          "content-type": "application/json"
        },
        "body": "{data}"
      },
      "functions": {
        "createCategory": ["data"]
      }
    },
    {
      "template": {
        "method": "GET",
        "url": "http://localhost:3003/categories/{id}",
        "headers": {
          "accept": "application/json"
        }
      },
      "functions": {
        "findCategoryById": ["id"]
      }
    }
  ]
}