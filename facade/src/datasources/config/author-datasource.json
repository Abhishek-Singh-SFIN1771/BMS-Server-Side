{
  "name": "author",
  "connector": "rest",
  "baseURL": "http://localhost:3002",
  "crud": false,
  "operations": [
    {
      "template": {
        "method": "GET",
        "url": "http://localhost:3002/authors",
        "query": {
          "name": "{name}"
        },
        "headers": {
          "accept": "application/json"
        }
      },
      "functions": {
        "findAuthorByName": ["name"]
      }
    },
    {
      "template": {
        "method": "POST",
        "url": "http://localhost:3002/authors",
        "headers": {
          "accept": "application/json",
          "content-type": "application/json"
        },
        "body": "{data}"
      },
      "functions": {
        "createAuthor": ["data"]
      }
    },
    {
      "template": {
        "method": "GET",
        "url": "http://localhost:3002/authors/{id}",
        "headers": {
          "accept": "application/json"
        }
      },
      "functions": {
        "findAuthorById": ["id"]
      }
    }
  ]
}