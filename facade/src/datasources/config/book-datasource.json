{
  "name": "book",
  "connector": "rest",
  "baseURL": "http://localhost:3001",
  "crud": false,
  "operations": [
    {
      "template": {
        "method": "POST",
        "url": "http://localhost:3001/books",
        "headers": {
          "accept": "application/json",
          "content-type": "application/json"
        },
        "body": "{data}"
      },
      "functions": {
        "createBook": ["data"]
      }
    },
    {
      "template": {
        "method": "GET",
        "url": "http://localhost:3001/books",
        "headers": {
          "accept": "application/json"
        }
      },
      "functions": {
        "getBook": []
      }
    },
    {
      "template": {
        "method": "GET",
        "url": "http://localhost:3001/books/{isbn}",
        "headers": {
          "accept": "application/json"
        }
      },
      "functions": {
        "findBookByIsbn": ["isbn"]
      }
    }
  ]
}